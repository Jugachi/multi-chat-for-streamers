{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Multi-Chat",
  "version": "2.0.0",
  "identifier": "com.jugachi.multichat",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Twitch, YouTube, Kick and TikTok chat in one window and OBS overlay",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
